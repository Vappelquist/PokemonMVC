@model PokemonMVC.Models.PokemonSearch

<h1>Search Pokémon</h1>

<form method="post" asp-controller="Pokesearch" asp-action="Index">
    <input type="text" name="name" placeholder="Search for pokémon, e.g. Eevee"/>
    <button type ="submit">Search</button>
</form>

@if (ViewBag.Error != null)
{
    <p class="text-danger">@ViewBag.Error</p>
}

else if (Model != null)
{
    <h2>@Model.PokemonName (@Model.PokemonId)</h2>
    @* <smg src="@Model.Sprites.FrontDefault" alt="@Model.PokemonName"/> *@
}


