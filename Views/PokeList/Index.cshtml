@model PokemonMVC.Models.PokeListViewModel

<form class "searchbar" method="post" asp-controller="PokeList" asp-action="Index">
    <input type="text" name="name" placeholder="Search for pokémon" />
    <button type="submit"></button>
</form>

@if (Model.Error != null)
{
    <p class="text-danger">@Model.Error</p>
}
@if (Model.SearchResult != null)
{
    
    <h2>@Model.SearchResult.PokemonName (#@Model.SearchResult.PokemonId)</h2>
    <img src="@Model.SearchResult.sprites?.FrontDefault" alt="@Model.SearchResult.PokemonName" width="120" />
    <p>"Height: @Model.SearchResult.Height | Weight: @Model.SearchResult.weight"</p>

    <div>
        @foreach (var t in Model.SearchResult.Types)
        {
            <span class="type-badge" style="background-color: var(--type-@t.Type.Name)">
                @t.Type.Name
            </span>
        }
    </div>
}
else if (Model.AllPokemon != null)
{
    <p class="total">Total: @Model.AllPokemon.Count</p>
    <ul class="PokeSearch">
        @foreach (var p in Model.AllPokemon.Results)
        {
            <li class="PokemonCardS">
                <a asp-controller="PokeList" asp-action="Details" asp-route-id="@p.Id" class="PokemonCardS">
                    <img src="@p.SpriteUrl" alt="@p.Name" width="120" />
                <p>@p.Name</p>
            </a>
            </li>
        }
    </ul>
}